{
  "expo": {
    "name": "星火日曆",
    "slug": "wtdt-spark-calendar",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "calendar-reminders"
        }
      ]
    ],
    "android": {
      "package": "com.wtdt.sparkcalendar",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "ios": { "bundleIdentifier": "com.wtdt.sparkcalendar", "supportsTablet": true }
  }
}
